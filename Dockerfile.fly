# Fly.io build for atomik-docs (Docusaurus static site).
# Named Dockerfile.fly (not Dockerfile) so Railway's nixpacks build is unaffected.
ARG NODE_VERSION=22.21.1

FROM node:${NODE_VERSION}-slim AS build
WORKDIR /app
# Install deps first for layer caching
COPY package.json package-lock.json ./
RUN npm ci
# Build the static site
COPY . .
RUN npm run build

# Serve with nginx: instant boot on Fly machine wake (docusaurus serve took
# seconds to start, 503ing the first visitor's asset requests after idle) and
# the image ships only the built site, not node_modules.
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 8080
